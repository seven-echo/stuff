# .env.example - 环境变量示例文件
# 复制此文件为 .env 并填入真实的配置值

# 应用环境配置
FLASK_ENV=development
DEBUG=true

# OpenBB API配置 (可选，用于获取更多数据源)
OPENBB_API_KEY=your_openbb_api_key_here

# 数据库配置 (可选，用于用户管理)
DATABASE_URL=postgresql://postgres:password123@localhost:5432/stock_analyzer
POSTGRES_PASSWORD=password123

# Redis配置 (可选，用于缓存)
REDIS_URL=redis://localhost:6379/0

# 安全配置
SECRET_KEY=your_secret_key_here_please_change_this

# 新闻API配置 (可选，用于情感分析)
NEWS_API_KEY=your_news_api_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# 邮件配置 (可选，用于通知)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_email_password

# 微信机器人配置 (可选，用于通知)
WECHAT_WEBHOOK_URL=your_wechat_webhook_url

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=/var/log/stock_analyzer.log

# Streamlit配置
STREAMLIT_THEME_BASE=light
STREAMLIT_THEME_PRIMARY_COLOR=#FF6B6B
STREAMLIT_THEME_BACKGROUND_COLOR=#FFFFFF
STREAMLIT_THEME_SECONDARY_BACKGROUND_COLOR=#F0F2F6
STREAMLIT_THEME_TEXT_COLOR=#262730

# 限流配置
RATE_LIMIT_PER_MINUTE=60
MAX_DAILY_REQUESTS=1000

# 缓存配置
CACHE_TTL_STOCK_DATA=1800
CACHE_TTL_NEWS_DATA=3600
CACHE_TTL_FUNDAMENTAL=86400